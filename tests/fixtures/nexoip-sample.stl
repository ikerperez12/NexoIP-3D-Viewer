solid nexoip_sample
  facet normal 0 0 -1
    outer loop
      vertex -1 0 -1
      vertex 1 0 1
      vertex 1 0 -1
    endloop
  endfacet
  facet normal 0 0 -1
    outer loop
      vertex -1 0 -1
      vertex -1 0 1
      vertex 1 0 1
    endloop
  endfacet
  facet normal 0 1 -1
    outer loop
      vertex -1 0 -1
      vertex 1 0 -1
      vertex 0 1.6 0
    endloop
  endfacet
  facet normal 1 1 0
    outer loop
      vertex 1 0 -1
      vertex 1 0 1
      vertex 0 1.6 0
    endloop
  endfacet
  facet normal 0 1 1
    outer loop
      vertex 1 0 1
      vertex -1 0 1
      vertex 0 1.6 0
    endloop
  endfacet
  facet normal -1 1 0
    outer loop
      vertex -1 0 1
      vertex -1 0 -1
      vertex 0 1.6 0
    endloop
  endfacet
endsolid nexoip_sample
